# Server Configuration
PORT=3000

# Database (Required)
# If your password contains special characters like @, #, $, %, you MUST URL-encode them.
# Example: mongodb+srv://user:pass%40123@cluster.mongodb.net/dbname
MONGODB_URI=

# AI Features (Required for item analyzer and smart features)
GEMINI_API_KEY=

# Firebase (Optional: use service account for full admin capabilities if running outside AI Studio)
# FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", ...}'

# Note: In AI Studio, configure these variables in the Settings menu.
# For local development, copy this file to a new file named .env
