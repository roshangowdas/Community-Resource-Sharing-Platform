rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reuseable helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
      
      function isValidUser(data) {
        return data.keys().hasAll(['name', 'email']) &&
               data.name is string && data.name.size() <= 100 &&
               data.email is string && data.email.size() <= 100;
      }
    }

    // Items
    match /items/{itemId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidItem(request.resource.data) && isOwner(request.resource.data.owner);
      allow update: if isSignedIn() && (
        (isOwner(resource.data.owner) && isValidItem(request.resource.data)) ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'saveCount']))
      );
      allow delete: if isSignedIn() && isOwner(resource.data.owner);

      function isValidItem(data) {
        return data.owner is string &&
               data.title is string && data.title.size() <= 200 &&
               data.category is string;
      }
    }

    // Requests
    match /requests/{requestId} {
      allow read: if isSignedIn() && (isOwner(resource.data.owner) || isOwner(resource.data.requester));
      allow create: if isSignedIn() && isOwner(request.resource.data.requester);
      allow update: if isSignedIn() && (isOwner(resource.data.owner) || isOwner(resource.data.requester));
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && isOwner(resource.data.recipient);
      allow write: if false; // Only server should write
    }
  }
}
